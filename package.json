{
  "name": "@arifszn/gitprofile",
  "description": "Create an automatic portfolio based on GitHub profile",
  "version": "2.6.0",
  "license": "MIT",
  "author": "arifszn",
  "repository": {
    "type": "git",
    "url": "https://github.com/arifszn/gitprofile.git"
  },
  "bugs": {
    "url": "https://github.com/arifszn/gitprofile/issues"
  },
  "files": [
    "dist/*.js",
    "dist/gitprofile.umd.cjs",
    "dist/style.css",
    "types"
  ],
  "main": "./dist/gitprofile.umd.cjs",
  "module": "./dist/gitprofile.es.js",
  "exports": {
    ".": {
      "import": "./dist/gitprofile.es.js",
      "require": "./dist/gitprofile.umd.cjs"
    },
    "./dist/style.css": "./dist/style.css"
  },
  "typings": "./types/index.d.ts",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "build:library": "vite build --config library.config.js",
    "lint": "eslint . --max-warnings 0",
    "lint:fix": "eslint . --fix --max-warnings 0",
    "prettier": "prettier --check \"./**/*.{js,jsx,mjs,ts,tsx,css,md,json}\"",
    "prettier:fix": "prettier --write \"./**/*.{js,jsx,mjs,ts,tsx,css,md,json}\"",
    "test": "node --test tests/*.test.mjs"
  },
  "dependencies": {
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@arifszn/blog-js": "^2.0.6",
    "@vitejs/plugin-react": "^6.1.0",
    "autoprefixer": "^10.6.1",
    "axios": "^1.20.0",
    "daisyui": "^3.9.4",
    "date-fns": "^4.4.0",
    "eslint": "^9.39.5",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-prettier": "^5.5.6",
    "eslint-plugin-react": "^7.37.5",
    "postcss": "^8.5.26",
    "prettier": "^3.9.6",
    "prop-types": "^15.8.1",
    "react-helmet-async": "^2.0.5",
    "react-hotjar": "^6.3.1",
    "react-icons": "^5.7.0",
    "tailwindcss": "^3.4.19",
    "vite": "^8.2.2",
    "vite-plugin-pwa": "^1.3.0",
    "@eslint/js": "^9.39.5",
    "globals": "^17.11.0"
  },
  "keywords": [
    "git-profile",
    "gitprofile",
    "gitportfolio",
    "personal-site",
    "template",
    "portfolio",
    "resume",
    "cv",
    "personal-website",
    "portfolio-website",
    "portfolio-site",
    "portfolio-template",
    "portfolio-page",
    "developer-portfolio",
    "portfolio-project",
    "github-portfolio",
    "tailwind-portfolio",
    "vite-portfolio",
    "projects",
    "open-source",
    "git",
    "react-portfolio",
    "github",
    "github-page",
    "github-pages",
    "github-portfolio",
    "vite-portfolio",
    "github-api"
  ],
  "type": "module",
  "engines": {
    "node": "^20.19.0 || >=22.12.0"
  }
}
